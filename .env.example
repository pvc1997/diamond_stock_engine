# === AI Settings ===
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.0-flash
AI_RETRY_LIMIT=3
AI_RATE_LIMIT_RPM=15
AI_TOXICITY_THRESHOLD=0.6

# === Cache TTLs (seconds) ===
CACHE_SCREENER_TTL=86400        # 24 hours
CACHE_PRICES_TTL=14400          # 4 hours
CACHE_SENTIMENT_TTL=3600        # 1 hour

# === Portfolio Constraints ===
MAX_POSITION_WEIGHT=0.10        # 10% max single stock
MAX_STOCKS_PER_SECTOR=4
MAX_SECTOR_EXPOSURE=0.25        # 25% max single sector

# === Risk Management ===
STOP_LOSS_THRESHOLD=0.10        # 10% trailing stop
COOLDOWN_DAYS=5
INITIAL_CAPITAL=100000

# === Rebalancing ===
REBALANCE_FREQUENCY_DAYS=90     # Quarterly
DRIFT_THRESHOLD=0.05            # 5% position drift
MIN_TRADE_VALUE=1000            # INR
ANNUAL_TURNOVER_BUDGET=0.50     # 50%

# === Screener ===
LOOKBACK_DAYS=504               # ~2 years trading days
RISK_FREE_RATE=0.065            # 6.5% (India)

# === Passive (benchmark reference) ===
PASSIVE_INDEX_TICKER=^NSEI
PASSIVE_TARGET_TRACKING_ERROR=0.002

# === God's Plan Strategy ===
GODS_PLAN_REBALANCE_DAYS=90
GODS_PLAN_MAX_POSITION_WEIGHT=0.12    # 12% max single stock
GODS_PLAN_CORE_MIN_ALPHA=0.15
GODS_PLAN_CORE_MIN_CAGR=0.18
GODS_PLAN_CORE_MIN_HURST=0.50
GODS_PLAN_CORE_MIN_BETA=0.80
GODS_PLAN_CORE_MAX_BETA=1.30
GODS_PLAN_DRAWDOWN_CRITICAL_PCT=20.0  # Higher threshold for aggressive

# === Kite Connect (Live Trading) ===
# KITE_API_KEY=your_key
# KITE_API_SECRET=your_secret
# KITE_EXCHANGE=NSE
# KITE_PRODUCT_TYPE=CNC             # CNC for delivery
# KITE_ORDER_VALIDITY=DAY
# KITE_DRY_RUN=true                 # Set to false for real trades
# KITE_CIRCUIT_BREAKER_PCT=0.05     # 5% price deviation limit
# KITE_MAX_TRADE_VALUE=50000        # Max single trade in INR
# KITE_MAX_TRADES_PER_SESSION=30
